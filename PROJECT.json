{
  "name": "VmMaintenance",
  "version": "2.7.0",
  "license": "private",
  "summary": "Fleet maintenance console for Windows servers and Azure VMs, with a host agent run inside RDP/RDM.",
  "platform": {
    "laptop": "Windows, PowerShell 5.1 and 7",
    "host_agent": "Windows PowerShell 2.0-5.1"
  },
  "programs": {
    "manager": "vmm (module VmMaintenance) on the laptop",
    "extractor": "Resources/VmmHostAgent.ps1 template -> VmmExtractor.ps1 (any host) / VmmExtractor_<HOST>_<time>.ps1 (with plan); writes VMM_<HOST>_<time>.vmm on the host desktop; Manager imports from Collect.InboxFolders"
  },
  "workflow": [
    "Precheck",
    "Stage",
    "PreSnapshot",
    "ExpandDisk",
    "Upgrade",
    "Verify"
  ],
  "time_rules": {
    "zone": "GMT Standard Time (Europe/Lisbon)",
    "business_hours": "Mon-Fri 08:00-17:00: read-only + staging to C:\\Temp",
    "other_times": "all steps",
    "override": "typed OVERRIDE + reason, logged"
  },
  "security": {
    "stored_credentials": false,
    "store": "AES-256-CBC + HMAC-SHA256, key under DPAPI CurrentUser",
    "agent_results": "RSA-3072 OAEP + AES-256-CBC + HMAC-SHA256",
    "repo_leak_check": "Tools/Test-Sanitized.ps1"
  },
  "integrations": {
    "azure": "Az.Accounts, Az.Compute, Az.ResourceGraph",
    "vpn": [
      "CiscoSecureClient",
      "Windows",
      "Probe"
    ],
    "ai_optional": [
      "Local (Foundry Local, Ollama)",
      "AzureOpenAI (Entra ID)"
    ],
    "future": [
      "MCP server for an approved work AI model"
    ],
    "github": {
      "via": "GitHub CLI (gh), its own sign-in",
      "commands": [
        "github",
        "update",
        "clone",
        "issue",
        "pr"
      ],
      "ci": ".github/workflows/ci.yml"
    }
  },
  "feature_flags": [
    "Features.HostAgent",
    "Features.Vpn",
    "Features.Ai"
  ],
  "cli_flags": [
    "--no-mouse",
    "--no-color",
    "--no-log",
    "--config",
    "--debug-errors",
    "--version"
  ],
  "exit_codes": {
    "0": "ok",
    "1": "error",
    "2": "usage",
    "3": "blocked by time window",
    "4": "VPN down",
    "5": "security check failed"
  },
