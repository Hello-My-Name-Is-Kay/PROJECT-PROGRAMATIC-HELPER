  "status": "Written and statically checked; not yet executed in PowerShell.",
  "creator": "Kay (GitHub: Hello-My-Name-Is-Kay)",
  "os_policy": {
    "target": "Windows Server 2019",
    "skip_unless_ordered": "client OS (Windows 10/11 ...)",
    "never_downgrade": "Server 2022/2025",
    "warn_management": [
      "Windows Server 2008 (not R2)",
      "physical machines"
    ],
    "disk_expand": "Azure, after business hours only, no override (VM deallocated)"
  },
  "media_repository": {
    "setting": "Staging.SourceShare",
    "root": "OS images named Win_Server_<version>_<LANG>.iso (e.g. Win_Server_2019_FR_FR.iso; _ or -, any case)",
    "host_folders": "<share>\\<HOST>\\* = files only that host needs (SQL Server updates)",
    "pick": "image for Staging.OsMediaVersion in the host's install language (Win32_OperatingSystem.OSLanguage); no fallback language",
    "hashes": "optional <file>.sha256 sidecar",
    "report": "vmm media"
  },
  "inventory": {
    "fields": "VmMaintenance/Resources/InventoryFields.psd1 (24 columns, CSV order, help text, agent service names)",
    "auto": "fleet check (CIM), host agent / collector Get-InvProbe -> Inv.<Key>= lines -> record.InventoryAuto",
    "derived": "ActionsToExecute, ActionsStatus, ExecutionDate from workflow",
    "manual": "record.Inventory via Set-VmmInventoryValue / I screen; Inventory.Defaults",
    "export": "Reports/Inventory/Inventory_<date>.csv",
    "help_change": "vmm helptext / T -> GitHub issue (.github/ISSUE_TEMPLATE/help-text.yml)"
  },
  "host_import": "CSV: hostname or FQDN, domain, IP (Read-VmmHostCsv: , ; tab, optional header); record.Fqdn used to connect, IPv4 fallback",
  "logging": {
    "live_pane": "bottom of every list screen, newest Log.PaneLines rows; F2 toggles on any screen (saved as Log.Live), F3 full log; --no-log for one run",
    "progress": "Invoke-VmmParallel logs each host step (Trace queue), each finished host with duration and a heartbeat every Log.HeartbeatSeconds naming the longest-running hosts; Wait-VmmJob and staging copies (Copy-VmmFileWithProgress) do the same",
    "file": "logs\\vmm_yyyyMMdd.log next to the data folder, every line (also action output), masked by Protect-VmmLogText and encrypted per line (E1: + base64 VMM1 blob) when Log.Encrypt; kept Log.KeepDays",
    "read": "vmm log [-Follow] [-Level] [-Find] [-Date] [-List] [-Export plaintext copy]"
  },
  "maintenance": {
    "command": "vmm maint -Action Diagnose|CheckStore|Backup|ListBackups|Restore|CleanLogs|CleanTemp|ResetUi",
    "menu": "M",
    "auto_backup": "one encrypted fleet store copy per day at start (Maintenance.AutoBackup, KeepBackups 14) in data\\backups"
  }
}
